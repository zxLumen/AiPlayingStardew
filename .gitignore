# ---- secrets (never commit) ----
config/secrets.json
.env
*.secrets.json

# ---- local run config (never commit) ----
# Holds the live room id and, if you filled it in, that room's SESSDATA - which is a login
# credential. Send a sanitised copy to program.example.json if the config needs to be shared.
config/program.json

# ---- reference projects: downloaded for study only, third-party code ----
# stardew-mcp has NO license, so it must never be redistributed.
vendor/

# ---- python ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# ---- dotnet ----
bin/
obj/
*.user

# ---- runtime output ----
logs/
*.log

# ---- the AI's own save identity (local to this machine) ----
config/ai_save.json

# ---- learning data (regenerated by playing; kept locally) ----
memory/journal/
memory/facts.json

# ---- credential backups (never commit) ----
config/*.bak
config/*.json.*

# ---- the voice/TTS stack: models and its own virtualenv ----
# 18.7 GB, including a full torch/CUDA install and multi-gigabyte checkpoint files. It is downloaded
# material, not source, and no repository should be asked to carry it.
tts/

# ---- the archived old save and old memory ----
# A local backup, kept on disk on purpose. Eight megabytes of somebody's save file is not source
# either: the rule is that the AI plays its own save, not that old ones live in git.
_archive/
