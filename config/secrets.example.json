{
  "_readme": [
    "COPY this file to secrets.json and fill in your key.",
    "secrets.json is gitignored and must never be committed.",
    "Priority: environment variable WINS over this file.",
    "  OPENCODE_API_KEY  -> overrides llm.api_key",
    "  DEEPSEEK_API_KEY  -> overrides fallback.api_key"
  ],

  "llm": {
    "provider": "opencode-go",
    "base_url": "https://opencode.ai/inference/go/openai/v1",
    "headers": {
      "x-opencode-org-id": "org_...",
      "x-opencode-session": "stardew-ai-<stable-id-per-conversation>",
      "User-Agent": "stardew-agent/0.1"
    },
    "api_key": "",
    "model": "deepseek-v4.1-flash",
    "reasoning_effort": "low",
    "temperature": 0.4,
    "max_tokens": 900,
    "timeout_s": 120
  },

  "fallback": {
    "provider": "deepseek",
    "base_url": "https://api.deepseek.com/v1",
    "api_key": "",
    "model": "deepseek-chat",
    "temperature": 0.4,
    "max_tokens": 900,
    "timeout_s": 120
  }
}
